<Window x:Class="Hyperion.DiagnosticWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hyperion - Startup Diagnostics" Width="640" Height="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="🛠️ Hyperion needs a quick repair" FontSize="22" FontWeight="SemiBold" />
        <ItemsControl Grid.Row="1" Margin="0,16" ItemsSource="{Binding Rows}"
                      AutomationProperties.Name="Diagnostic results">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Grid.Row="2" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,12" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Continue anyway" Margin="0,0,8,0" Padding="16,6" Click="OnContinueClick"
                    AutomationProperties.Name="Continue anyway" />
            <Button Content="1-Click Auto-Fix &amp; Download" Padding="16,6" Command="{Binding AutoFixCommand}"
                    AutomationProperties.Name="Auto-fix and download" />
        </StackPanel>
    </Grid>
</Window>
