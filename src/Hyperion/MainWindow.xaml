<Window x:Class="Hyperion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Hyperion.Views"
        Title="Hyperion" Width="1280" Height="800">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Compact chrome: ~24px controls instead of the theme's 32px. -->
        <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <Style x:Key="ChromeGlyph" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        </Style>
        <Style x:Key="HorizontalTabItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="MaxWidth" Value="200" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <Style x:Key="VerticalTabItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!-- One tab, shared by the horizontal strip and the vertical panel; the title and close button hide when collapsed to icons. -->
        <DataTemplate x:Key="TabTemplate">
            <Grid Background="Transparent" ToolTip="{Binding DisplayTitle}">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Pin / unpin tab" Click="OnPinClick" />
                        <MenuItem Header="Close tab" Click="OnCloseClick" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- The letter sits behind the favicon and shows when the icon is missing or cannot be decoded. -->
                <Grid Grid.Column="0" Width="16" Height="16">
                    <TextBlock Text="{Binding Initial}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding FaviconUri}" />
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Margin="6,0"
                           Visibility="{Binding DataContext.ShowTabTitles, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}" />
                <Button Grid.Column="2" Content="✕" Padding="4,0" MinHeight="20" MinWidth="20" BorderThickness="0" Background="Transparent"
                        Click="OnCloseClick" AutomationProperties.Name="Close tab"
                        Visibility="{Binding DataContext.ShowTabTitles, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Omni-bar -->
        <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="4,2"
              Visibility="{Binding IsChromeVisible, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource ChromeGlyph}" Content="&#xE700;" Margin="0,0,4,0"
                    Command="{Binding ToggleVerticalTabsCommand}" ToolTip="Vertical tabs"
                    AutomationProperties.Name="Toggle vertical tabs" />
            <Button Grid.Column="1" Style="{StaticResource ChromeGlyph}" Content="&#xE80F;" Margin="0,0,4,0"
                    Command="{Binding GoHomeCommand}" ToolTip="Home (start.me)" AutomationProperties.Name="Home (start.me)" />
            <TextBox Grid.Column="2" x:Name="OmniBar" MinHeight="24" Padding="6,2" VerticalContentAlignment="Center"
                     Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnOmniBarKeyDown" AutomationProperties.Name="Search or enter URL" />
            <ComboBox Grid.Column="3" MinWidth="72" MinHeight="24" Padding="6,2" Margin="4,0" ItemsSource="{Binding SuspendOptions}"
                      ItemStringFormat="{}💤 {0} min" SelectedItem="{Binding SuspendAfterMinutes}"
                      ToolTip="Background tabs you have not used for this long are suspended to save memory"
                      AutomationProperties.Name="Suspend idle tabs after minutes" />
            <Menu Grid.Column="4" Background="Transparent" VerticalAlignment="Center">
                <MenuItem Header="&#xE740;" FontFamily="Segoe Fluent Icons" ToolTip="Video: full screen / full window"
                          AutomationProperties.Name="Video display">
                    <MenuItem Header="Full screen" FontFamily="{x:Static SystemFonts.MessageFontFamily}"
                              Command="{Binding ToggleFullScreenCommand}" />
                    <MenuItem Header="Full window (borderless)" FontFamily="{x:Static SystemFonts.MessageFontFamily}"
                              Command="{Binding ToggleFullWindowCommand}" />
                </MenuItem>
            </Menu>
            <Button Grid.Column="5" Style="{StaticResource ChromeGlyph}" Content="&#xE713;"
                    Command="{Binding ToggleSettingsCommand}" ToolTip="Page shortcuts" AutomationProperties.Name="Page shortcut settings" />
        </Grid>

        <!-- Horizontal tab strip -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="3"
                   Visibility="{Binding ShowHorizontalTabs, Converter={StaticResource BoolToVis}}">
            <Button DockPanel.Dock="Right" Style="{StaticResource ChromeGlyph}" Content="&#xE710;" Margin="4,0"
                    Command="{Binding NewTabCommand}" ToolTip="New tab" AutomationProperties.Name="New tab" />
            <ListBox x:Name="TabDock" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                     ItemTemplate="{StaticResource TabTemplate}" ItemContainerStyle="{StaticResource HorizontalTabItem}"
                     BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Tab dock">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </DockPanel>

        <!-- Vertical tab panel (collapses to icons only) -->
        <DockPanel Grid.Row="2" Grid.Column="0" Width="{Binding VerticalTabWidth}"
                   Visibility="{Binding ShowVerticalTabs, Converter={StaticResource BoolToVis}}">
            <WrapPanel DockPanel.Dock="Top" Margin="4,2">
                <Button Style="{StaticResource ChromeGlyph}" Content="{Binding CollapseGlyph}" Margin="0,0,4,0"
                        Command="{Binding ToggleTabsCollapsedCommand}" ToolTip="Collapse / expand tabs"
                        AutomationProperties.Name="Collapse or expand tab panel" />
                <Button Style="{StaticResource ChromeGlyph}" Content="&#xE710;"
                        Command="{Binding NewTabCommand}" ToolTip="New tab" AutomationProperties.Name="New tab" />
            </WrapPanel>
            <ListBox x:Name="VerticalTabDock" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                     ItemTemplate="{StaticResource TabTemplate}" ItemContainerStyle="{StaticResource VerticalTabItem}"
                     BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Vertical tab dock" />
        </DockPanel>

        <!-- Web surface + settings drawer (in layout: the HWND-based WebView2 would hide overlays) -->
        <Grid x:Name="Surface" Grid.Row="2" Grid.Column="1" />
        <views:MediaSettingsOverlay x:Name="Drawer" Grid.Row="2" Grid.Column="2" Width="380" Visibility="Collapsed" />

        <!-- Status -->
        <DockPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="8,1" TextElement.FontSize="11"
                   Visibility="{Binding IsChromeVisible, Converter={StaticResource BoolToVis}}">
            <Button DockPanel.Dock="Right" Content="Update" Margin="8,0,0,0" Padding="8,0" MinHeight="20"
                    Command="{Binding InstallUpdateCommand}"
                    Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.Name="Install update" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding UpdateText}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
