<UserControl x:Class="Hyperion.Views.MediaSettingsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="OnPreviewKeyDown" Focusable="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <!-- No explicit Background: the window's themed background shows through, so text stays readable in light and dark. -->
    <Border Padding="16" BorderThickness="1,0,0,0" BorderBrush="#40808080">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Page shortcuts" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Reset" Command="{Binding ResetCommand}" Margin="0,0,8,0" Padding="14,6"
                            AutomationProperties.Name="Reset to defaults" />
                    <Button Content="Save" Command="{Binding SaveCommand}" Padding="14,6"
                            AutomationProperties.Name="Save media settings" />
                </StackPanel>
            </StackPanel>
            <Menu DockPanel.Dock="Top" Background="Transparent" Margin="0,0,0,8" HorizontalAlignment="Left">
                <MenuItem Header="＋ Add shortcut" AutomationProperties.Name="Add shortcut">
                    <MenuItem Header="Speed" Command="{Binding AddCommand}" CommandParameter="speed" />
                    <MenuItem Header="Fast forward (hold)" Command="{Binding AddCommand}" CommandParameter="fastforward" />
                    <MenuItem Header="Seek" Command="{Binding AddCommand}" CommandParameter="seek" />
                    <MenuItem Header="Full screen" Command="{Binding AddCommand}" CommandParameter="fullscreen" />
                    <MenuItem Header="Full window (borderless)" Command="{Binding AddCommand}" CommandParameter="fullwindow" />
                </MenuItem>
            </Menu>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Shortcuts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                          AutomationProperties.Name="{Binding Label}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Label}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <Button Content="{Binding Mode}" Padding="8,0" MinWidth="28"
                                            Visibility="{Binding HasMode, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.ToggleModeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="+ adds to the current speed, = sets it"
                                            AutomationProperties.Name="Speed mode" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="{Binding DisplayKey}" Click="OnRemapClick" Padding="8,2" MinWidth="88"
                                        Margin="4,0" AutomationProperties.Name="Key" />
                                <TextBox Grid.Column="3" Text="{Binding Value, UpdateSourceTrigger=LostFocus}" TextAlignment="Center"
                                         Visibility="{Binding HasValue, Converter={StaticResource BoolToVis}}"
                                         AutomationProperties.Name="Value" />
                                <Button Grid.Column="4" Content="✕" Padding="6,0" BorderThickness="0" Background="Transparent" Margin="4,0,0,0"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="Remove shortcut" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
