<UserControl x:Class="Hyperion.Views.MediaSettingsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="OnPreviewKeyDown" Focusable="True">
    <Border Padding="16" BorderThickness="1,0,0,0"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Media keys" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Reset" Command="{Binding ResetCommand}" Margin="0,0,8,0" Padding="14,6"
                            AutomationProperties.Name="Reset to defaults" />
                    <Button Content="Save" Command="{Binding SaveCommand}" Padding="14,6"
                            AutomationProperties.Name="Save media settings" />
                </StackPanel>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Speed step" FontWeight="SemiBold" />
                    <TextBox Text="{Binding SpeedStep, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,12"
                             AutomationProperties.Name="Speed step" />

                    <TextBlock Text="Speed presets" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Presets}" Margin="0,4,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="{Binding Label}" Width="120" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                             AutomationProperties.Name="{Binding Label}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Seek intervals" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding SeekSeconds}" Margin="0,4,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="{Binding Label}" Width="120" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                             AutomationProperties.Name="{Binding Label}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Hotkeys" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Hotkeys}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="{Binding Label}" Width="150" VerticalAlignment="Center" />
                                    <Button Content="{Binding Combo}" Click="OnRemapClick" Padding="8,4"
                                            AutomationProperties.Name="{Binding Label}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
