<UserControl x:Class="Hyperion.Views.MediaOsdBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top"
             Margin="0,16,16,0">
    <Border CornerRadius="8" Padding="14,8" Background="#CC202020" BorderBrush="#33FFFFFF" BorderThickness="1">
        <TextBlock x:Name="Label" Foreground="White" FontSize="16" FontWeight="SemiBold"
                   AutomationProperties.LiveSetting="Polite" />
    </Border>
</UserControl>
